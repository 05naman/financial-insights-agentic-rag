ENVIRONMENT=local
LOG_LEVEL=INFO

# Local default: SQLite + embedded Qdrant (no Docker needed).
# For the Docker services use:
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/financial_insights
#   QDRANT_URL=http://localhost:6333
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
QDRANT_URL=

PDF_DIR=../data/pdfs
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Tried in order; a model whose daily quota is used up is skipped. Write `provider:model` to pick a model.
# Groq free tier (per model): 30 requests/min, 8K tokens/min, 200K tokens/day. Current models: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
LLM_PROVIDERS=["groq:qwen/qwen3.8-27b","groq:openai/gpt-oss-120b","groq:openai/gpt-oss-20b","gemini","ollama"]

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
